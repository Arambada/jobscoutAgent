# ── Database (required) ─────────────────────────────────────────────────────────
# For local dev without Docker: install Postgres and create the db, or use
# the docker-compose setup which sets this automatically.
DATABASE_URL=postgres://jobscout:jobscout@localhost:5432/jobscout

# ── Anthropic (required) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Job search (Adzuna, required for searching) ────────────────────────────────
# Free credentials from https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country code: gb, us, ca, au, de, fr, etc. (default: gb)
ADZUNA_COUNTRY=gb

# ── Email via Resend (required for email digests) ──────────────────────────────
# The FROM domain must be verified at https://resend.com/domains. Without a
# domain, use "Job Scout <onboarding@resend.dev>" — it delivers only to the
# email address that owns the Resend account.
RESEND_API_KEY=re_...
EMAIL_FROM=Job Scout <onboarding@resend.dev>
EMAIL_TO=you@youremail.com

# ── Optional ───────────────────────────────────────────────────────────────────
# Override the search schedule (cron syntax). Default: derived from the
# "search every N hours" setting in the UI (12 hours unless changed).
# SEARCH_CRON=0 */12 * * *

# Base URL used in email links. Default: http://localhost:3000
# APP_URL=http://localhost:3000

# ── Extra job sources (optional) ──────────────────────────────────────────────
# Reed.co.uk — free key from https://www.reed.co.uk/developers
REED_API_KEY=
# JSearch (Google for Jobs: Indeed/LinkedIn/Glassdoor listings) — free key from
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# IMPORTANT: after creating the key you must also click "Subscribe to Test" on
# that page and pick the free Basic plan, or every request fails.
JSEARCH_API_KEY=
# JSearch country (default gb) and freshness window (today|3days|week|month, default today)
JSEARCH_COUNTRY=gb
# JSEARCH_DATE_POSTED=today
# NHS Jobs and Remotive need no keys. Set NHS_JOBS=off to disable NHS Jobs.
# NHS_JOBS=off
# Where you can legally work, for filtering remote listings (Remotive).
# Default is UK/Europe-based; outside the UK set your own region words:
# CANDIDATE_REGIONS=usa,united states,northern america,americas,worldwide,anywhere,global
# Auto-delete untouched "new" jobs older than N days on each run (off unless set)
# JOB_PURGE_DAYS=30
# Max listing age in days for all sources (default 60)
# JOB_MAX_DAYS_OLD=60
